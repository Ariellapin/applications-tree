<UserControl x:Class="WPFToolbarTree.Views.TreePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:WPFToolbarTree.Models"
             MinWidth="240" MinHeight="120" MaxWidth="420" MaxHeight="520"
             Background="Transparent">
    <Border Background="#FAFAFA"
            BorderBrush="#B0B0B0"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,2,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="WPFToolbarTree"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#404040"/>
                <Button Grid.Column="1"
                        x:Name="AddBtn"
                        Content="+"
                        ToolTip="Add an app, file, folder or URL"
                        Width="22" Height="22"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#404040"
                        Background="Transparent"
                        BorderBrush="#C0C0C0"
                        Cursor="Hand"
                        Click="OnAddClick"/>
            </Grid>

            <TreeView x:Name="Tree"
                      Grid.Row="1"
                      ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type m:FolderNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type m:ItemNode}">
                        <Border Background="Transparent"
                                MouseLeftButtonUp="OnItemClick"
                                Cursor="Hand"
                                Padding="0,1">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="2,1"/>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
