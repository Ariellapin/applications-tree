<Window x:Class="WPFToolbarTree.Views.AddEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add entry"
        Width="440" Height="270"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="ItemRadio" Content="Item / link"
                         IsChecked="True" Margin="0,0,16,0"
                         Checked="OnTypeChanged"/>
            <RadioButton x:Name="FolderRadio" Content="Folder"
                         Checked="OnTypeChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                 Margin="0,0,0,8" Padding="4,3" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="PathLabel" Grid.Row="2" Grid.Column="0" Text="Path / URL"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="PathBox" Grid.Row="2" Grid.Column="1"
                 Margin="0,0,8,8" Padding="4,3" VerticalContentAlignment="Center"/>
        <Button x:Name="BrowseBtn" Grid.Row="2" Grid.Column="2"
                Content="Browse..." Padding="10,3" Margin="0,0,0,8"
                Click="OnBrowse"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Add to"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="ParentBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                  Margin="0,0,0,8" Padding="4,3"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Folder"/>

        <TextBlock x:Name="HintLabel" Grid.Row="4" Grid.ColumnSpan="3"
                   Foreground="#909090" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Text="Files, .exe, .lnk, folders, and http(s) URLs are all supported."/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="OkBtn" Content="Add" Width="80"
                    IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
