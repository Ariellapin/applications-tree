<Application x:Class="WPFToolbarTree.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:views="clr-namespace:WPFToolbarTree.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/Resources/app.ico"
                        ToolTipText="WPFToolbarTree"
                        NoLeftClickDelay="True"
                        PopupActivation="None"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.TrayPopup>
                <views:TreePopup x:Name="PopupRoot"/>
            </tb:TaskbarIcon.TrayPopup>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Reload config" Click="OnReloadClick"/>
                    <MenuItem Header="Open config file" Click="OnOpenConfigClick"/>
                    <Separator/>
                    <MenuItem Header="Start with Windows"
                              IsCheckable="True"
                              x:Name="AutoStartMenuItem"
                              Click="OnAutoStartClick"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="OnExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
